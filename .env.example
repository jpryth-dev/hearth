# Copy to .env and fill in. Never commit .env.
# Matches docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://hearth:hearth@localhost:5433/hearth"
# Integration tests only. Must be a separate database whose name ends in _test;
# the test setup refuses anything else because it truncates every table.
TEST_DATABASE_URL="postgresql://hearth:hearth@localhost:5433/hearth_test"

# Base URL used to build links in emails. Never derived from request headers.
APP_URL="http://localhost:3000"

# Outgoing mail. Mailpit (docker-compose.yml) in development.
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="Hearth <no-reply@hearth.local>"

# Photo storage (S3-compatible). RustFS from docker-compose.yml in development;
# Cloudflare R2 or AWS S3 in production (omit S3_ENDPOINT for AWS).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="hearth-photos"
S3_ACCESS_KEY_ID="hearth"
S3_SECRET_ACCESS_KEY="hearth-dev-secret"
S3_FORCE_PATH_STYLE="true"
# Integration and e2e tests use their own bucket.
TEST_S3_BUCKET="hearth-photos-test"
